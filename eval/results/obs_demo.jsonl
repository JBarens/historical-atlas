, {"chunk": 7727, "rrf_pos": 40, "rrf_score": 0.019233, "dense_pos": 45, "bm25_pos": 43}, {"chunk": 3527, "rrf_pos": 41, "rrf_score": 0.018972, "dense_pos": 60, "bm25_pos": 34}, {"chunk": 7967, "rrf_pos": 42, "rrf_score": 0.018689, "dense_pos": 66, "bm25_pos": 33}, {"chunk": 753, "rrf_pos": 43, "rrf_score": 0.018339, "dense_pos": 35, "bm25_pos": 68}, {"chunk": 7832, "rrf_pos": 44, "rrf_score": 0.018301, "dense_pos": 93, "bm25_pos": 25}, {"chunk": 986, "rrf_pos": 45, "rrf_score": 0.018277, "dense_pos": 32, "bm25_pos": 75}, {"chunk": 8707, "rrf_pos": 46, "rrf_score": 0.017868, "dense_pos": 30, "bm25_pos": 88}, {"chunk": 7833, "rrf_pos": 47, "rrf_score": 0.017509, "dense_pos": 36, "bm25_pos": 81}, {"chunk": 8720, "rrf_pos": 48, "rrf_score": 0.017397, "dense_pos": 57, "bm25_pos": 53}, {"chunk": 2906, "rrf_pos": 49, "rrf_score": 0.017371, "dense_pos": 49, "bm25_pos": 62}, {"chunk": 8711, "rrf_pos": 50, "rrf_score": 0.015423, "dense_pos": 87, "bm25_pos": 56}]}, "rerank": {"model": "claude-haiku-5-5", "reranked_n": 50, "reranked": [{"chunk": 3507, "rerank_pos": 1, "rrf_pos": 2}, {"chunk": 3517, "rerank_pos": 2, "rrf_pos": 3}, {"chunk": 3509, "rerank_pos": 3, "rrf_pos": 7}, {"chunk": 3511, "rerank_pos": 4, "rrf_pos": 32}, {"chunk": 3506, "rerank_pos": 5, "rrf_pos": 1}, {"chunk": 3510, "rerank_pos": 6, "rrf_pos": 4}, {"chunk": 3516, "rerank_pos": 7, "rrf_pos": 6}, {"chunk": 3508, "rerank_pos": 8, "rrf_pos": 8}, {"chunk": 3514, "rerank_pos": 9, "rrf_pos": 9}, {"chunk": 3515, "rerank_pos": 10, "rrf_pos": 36}, {"chunk": 3512, "rerank_pos": 11, "rrf_pos": 5}, {"chunk": 3522, "rerank_pos": 12, "rrf_pos": 10}, {"chunk": 3523, "rerank_pos": 13, "rrf_pos": 11}, {"chunk": 3524, "rerank_pos": 14, "rrf_pos": 28}, {"chunk": 3525, "rerank_pos": 15, "rrf_pos": 14}, {"chunk": 3527, "rerank_pos": 16, "rrf_pos": 41}, {"chunk": 8719, "rerank_pos": 17, "rrf_pos": 12}, {"chunk": 8720, "rerank_pos": 18, "rrf_pos": 48}, {"chunk": 8721, "rerank_pos": 19, "rrf_pos": 29}, {"chunk": 8727, "rerank_pos": 20, "rrf_pos": 21}]}, "chunk_ids": [3507, 3517, 3509, 3511, 3506], "top_chunks": [{"chunk": 3507, "doc_id": "hansard:S5CV0161P0-06294", "text": "[Commons, 1923-03-19, \"VILNA.\", Mr. McNEILL]\nThe answer to the first part of the question is in the affirmative. The Ambassadors' Conference derives the authority to take such a decision from Article 87 of the Treaty of Versailles, which stipulates that the boundaries of Poland not laid down in the Treaty will be subsequently determined by the Principal Allied and Associated Powers."}, {"chunk": 3517, "doc_id": "hansard:S5CV0161P0-06304", "text": "[Commons, 1923-03-19, \"VILNA.\", The PRIME MINISTER]\nThe decision of the Ambassadors' Conference, as has already been explained to the hon. Member, was directly based on the authority conferred on the Allies by Article 87 of the Treaty of Versailles. There is no question of substituting the actions and decisions of the Ambassadors' Conference for those of the League of Nations, whose authority with regard to questions which fall within its competence necessarily remains unimpaired."}, {"chunk": 3509, "doc_id": "hansard:S5CV0161P0-06296", "text": "[Commons, 1923-03-19, \"VILNA.\", Mr. McNEILL]\nThe Ambassadors' Conference, of course, represents the Governments who have given them their powers, and the decision in this case is taken by the Allied and Associated Powers, who are acting through the Ambassadors, who are assembled, for convenience sake, in Paris."}, {"chunk": 3511, "doc_id": "hansard:S5CV0161P0-06298", "text": "[Commons, 1923-03-19, \"VILNA.\", Mr. McNEILL]\nNo, Sir; it is not correct to say that it was handed over to the League of Nations. The League of Nations were informally asked if they would devise conditions and submit them to the parties interested. They did so, and the parties, as a matter of fact, rejected those terms; consequently, the responsibility for a decision was thrown back upon the Allied and Associated Powers."}, {"chunk": 3506, "doc_id": "hansard:S5CV0161P0-06293", "text": "[Commons, 1923-03-19, \"VILNA.\", Mr. TREVELYAN]\nasked the Under-Secretary of State for Foreign Affairs whether the Ambassadors' Conference have decided that Vilna shall be awarded to Poland; and what authority the Ambassadors' Conference has for making a decision?"}], "answer": "The Ambassadors' Conference cited Article 87 of the Treaty of Versailles as its authority for the Vilna decision. Article 87 stipulates that Poland's boundaries not laid down in the Treaty will be subsequently determined by the Principal Allied and Associated Powers. The Prime Minister stated the decision was directly based on the authority conferred on the Allies by that Article.", "message": null, "stop": "tool_use", "claims": [{"claim": "The Ambassadors' Conference derives its authority to take the Vilna decision from Article 87 of the Treaty of Versailles.", "source": "chunk", "chunk_id": 1, "in_range": true}, {"claim": "Article 87 stipulates that Poland's boundaries not laid down in the Treaty will be subsequently determined by the Principal Allied and Associated Powers.", "source": "chunk", "chunk_id": 1, "in_range": true}, {"claim": "The Prime Minister stated the Ambassadors' Conference decision was directly based on the authority conferred on the Allies by Article 87 of the Treaty of Versailles.", "source": "chunk", "chunk_id": 2, "in_range": true}], "tool_calls": [], "models": {"rerank": "claude-haiku-5-5", "generate": "claude-haiku-5-5"}, "tokens": {"rerank": {"input": 11153, "output": 91}, "generate": {"input": 2084, "output": 446}}, "tokens_total": {"input": 13237, "output": 537}, "cost_usd": {"rerank": 0.011608, "generate": 0.004314}, "cost_usd_total": 0.015922, "cost_note": "assumed prices: Haiku $1/M input, $5/M output", "latency_ms": {"retrieve": 9385.2, "rerank": 1188.7, "generate": 1898.6}, "latency_ms_total": 12472.6, "spans": [{"id": "80a4b9cd", "parent": null, "name": "request", "start": "2026-11-18T13:48:21.501+00:00", "end": "2026-11-